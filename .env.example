# Copy to .env next to docker-compose.yml to override the defaults.
# The address the site is served on (needs a DNS record pointing at your Traefik host):
POSTSTREAM_HOST=m365blogs.runr.is
# Anyone can create an account by default. Set to 0 to close sign-up (you can still add users with adduser).
#ALLOW_SIGNUP=1
# Stop accepting sign-ups after this many accounts.
#MAX_USERS=1000
